# ---- Database ----
# Local dev: `docker compose up -d` (or paste a free Neon dev-branch URL instead)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/dsapod
# Production (Neon free tier): use the *pooled* URL here and the direct URL for migrations
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_DIRECT=postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth ----
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → Credentials → OAuth client (Web). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated. These become admins on first sign-in; manage others in /admin/members.
ADMIN_EMAILS=
# Optional: restrict sign-up to these domains (comma-separated). Empty = any account.
ALLOWED_EMAIL_DOMAINS=

# ---- Email magic link (Resend free tier: 100/day; Google stays the main sign-in) ----
RESEND_API_KEY=
EMAIL_FROM="DSA POD <no-reply@yourdomain.com>"

# ---- Reminders (free broadcast channels) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---- /api/cron/* protection ----
CRON_SECRET=
